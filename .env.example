# ─── Atlas: Trello ───────────────────────────────────────────────────────────
# API key + token from trello.com/app-key.
# See docs/atlas-integrations.md §2 for setup steps.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_WORKSPACE_ID=

# ─── Atlas: Trainual ─────────────────────────────────────────────────────────
# API key from app.trainual.com/settings/integrations.
# See docs/atlas-integrations.md §3 for setup steps.
TRAINUAL_API_KEY=
TRAINUAL_ACCOUNT_ID=

# ─── Atlas: Integration mode ─────────────────────────────────────────────────
# Set to "mock" locally so adapter calls return fixture data without hitting
# live provider APIs. Set to "live" (or leave unset) in staging/production.
INTEGRATION_MODE=mock
