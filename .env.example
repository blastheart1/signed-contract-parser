# Copy this file to .env.local and fill in all values before running locally.
# Never commit .env.local — it is gitignored.

# ─── Database ────────────────────────────────────────────────────────────────
# Vercel Postgres (Neon) connection string.
POSTGRES_URL=

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Order Approvals ─────────────────────────────────────────────────────────
# Zapier webhook for sending approval confirmation emails (manual trigger).
# Optional during dev; required in production.
ORDER_APPROVAL_ZAPIER_WEBHOOK_URL=

# ─── Atlas: Google Workspace ──────────────────────────────────────────────────
# Service account with domain-wide delegation.
# See docs/atlas-integrations.md §1 for IAM setup steps.


# ─── Atlas: Trello ───────────────────────────────────────────────────────────
# API key + token from trello.com/app-key.
# See docs/atlas-integrations.md §2 for setup steps.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_WORKSPACE_ID=
# Board ID to invite new hires into (from the board URL).
TRELLO_BOARD_ID=

# ─── Atlas: Trainual ─────────────────────────────────────────────────────────
# API key from app.trainual.com/settings/integrations.
# See docs/atlas-integrations.md §3 for setup steps.
TRAINUAL_API_KEY=
TRAINUAL_ACCOUNT_ID=

# ─── Atlas: Integration mode ─────────────────────────────────────────────────
# Set to "mock" locally so adapter calls return fixture data without hitting
# live provider APIs. Set to "live" (or leave unset) in staging/production.
INTEGRATION_MODE=mock

# ─── Atlas: Onboarding email ─────────────────────────────────────────────────
# Zapier Catch Hook URL. When set, Atlas fires a POST after Google account
# creation to send credentials to the new hire's personal email.
# See onboardingemailwebhook.md for full Zapier setup guide.
ATLAS_ONBOARDING_WEBHOOK_URL=
